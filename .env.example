# =========================================================================
# Ru de Ménilmontant — variables d'environnement
# Copier ce fichier en « .env.local » et renseigner les vraies valeurs.
# .env.local N'EST JAMAIS COMMITÉ (voir .gitignore).
# =========================================================================

# --- Supabase (auth email + table `scans`) -------------------------------
# Tableau de bord Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : uniquement côté serveur, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox (carte interactive du tracé) ---------------------------------
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- URL publique du site (pour la génération des QR codes) --------------
# ex. https://ru-menilmontant.vercel.app  (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
